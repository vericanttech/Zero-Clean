rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Processed images: datasets/{userId}/{shopId}/{category}/{variantLabel}/{context}/{imageId}.jpg
    // User can only read/write under their own userId folder
    match /datasets/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
